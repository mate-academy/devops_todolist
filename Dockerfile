# -------------------------------
# ARG — змінна для версії Python
# Для чого: щоб можна було легко змінити базовий образ
# -------------------------------
ARG PYTHON_VERSION=3.11-slim

# -------------------------------
# BUILD STAGE
# Для чого: тут збираємо додаток і ставимо залежності
# -------------------------------
FROM python:${PYTHON_VERSION} AS builder

# -------------------------------
# ENV PYTHONUNBUFFERED=1
# Для чого: щоб логи Python/Django одразу показувались у терміналі Docker
# -------------------------------
ENV PYTHONUNBUFFERED=1

# -------------------------------
# Робоча папка всередині контейнера
# Для чого: тут буде лежати наш проект
# -------------------------------
WORKDIR /app

# -------------------------------
# Копіюємо файл залежностей окремо
# Для чого: Docker краще кешує цей крок
# -------------------------------
COPY requirements.txt .

# -------------------------------
# Встановлюємо залежності
# Для чого: щоб Django і всі пакети були доступні в контейнері
# -------------------------------
RUN pip install --no-cache-dir -r requirements.txt

# -------------------------------
# Копіюємо весь проект
# Для чого: переносимо код додатку всередину контейнера
# -------------------------------
COPY . .

# -------------------------------
# Виконуємо міграції
# Для чого: створити структуру бази даних
# Це прямо вимагається в завданні
# -------------------------------
RUN python manage.py migrate


# -------------------------------
# RUN STAGE
# Для чого: фінальний етап запуску контейнера
# -------------------------------
FROM python:${PYTHON_VERSION} AS runner

# -------------------------------
# Знову додаємо змінну середовища
# Для чого: щоб у фінальному контейнері теж були нормальні логи
# -------------------------------
ENV PYTHONUNBUFFERED=1

# -------------------------------
# Робоча папка
# -------------------------------
WORKDIR /app

# -------------------------------
# Копіюємо встановлені пакети з builder
# Для чого: не встановлювати все заново
# -------------------------------
COPY --from=builder /usr/local /usr/local

# -------------------------------
# Копіюємо проект з builder
# Для чого: перенести готовий код у фінальний контейнер
# -------------------------------
COPY --from=builder /app /app

# -------------------------------
# Відкриваємо порт 8080
# Для чого: документація і зручність, щоб було видно який порт використовує додаток
# -------------------------------
EXPOSE 8080

# -------------------------------
# Команда запуску Django
# Для чого: запускати сервер правильно всередині Docker
# 0.0.0.0 — щоб контейнер був доступний зовні
# 8080 — це вимагається завданням
# -------------------------------
CMD ["python", "manage.py", "runserver", "0.0.0.0:8080"]