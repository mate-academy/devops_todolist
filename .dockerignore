# Git / VCS
.git/
.gitignore
.gitattributes

# Python bytecode / cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Packaging/build artifacts
*.egg
*.egg-info/
.eggs/
*.whl
pip-wheel-metadata/
build/
dist/
.wheelhouse/

# Virtual environments
venv/
.venv/
env/
env.bak/

# Environment and secrets (do not send into build context)
.env
.env.*
*.env

# Django
*.sqlite3
*.log
logs/
media/
# Keep app static sources, ignore only collectstatic output
staticfiles/

# Test and tooling caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pyre/
.cache/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.iml

# Node (if present in project)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Docker
# Keep Dockerfile in context; ignore only compose files
docker-compose.yml
docker-compose.*.yml
